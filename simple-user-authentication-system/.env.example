# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is gitignored - it never gets committed. .env.example IS
# committed, as a template showing which variables exist (with no real
# values in it), so anyone setting up the project knows what to fill in.

APP_ENV=local

# Optional: override where the SQLite database file is stored.
# Leave blank to use the default (data/users.sqlite).
DB_PATH=

# If you extend this project with something that needs a real secret
# (an email API key, a payment provider token, etc.), add it here as
# NAME=your-value and read it in PHP with getenv('NAME'). Never write
# the actual value into a .php file or into this .example file.
